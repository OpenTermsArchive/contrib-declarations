{
  "name": "Facebook",
  "terms": {
    "Privacy Policy": {
      "fetch": "https://fr-fr.facebook.com/privacy/explanation/",
      "filter": [
        "removeEmptyAnchorsLinks",
        {
          "removeQueryParams": [
            "h",
            "locale2"
          ]
        }
      ],
      "select": [
        "hr+div"
      ],
      "executeClientScripts": true
    },
    "Terms of Service": {
      "fetch": "https://fr-fr.facebook.com/legal/terms/plain_text_terms",
      "select": [
        "div[role=\"main\"]"
      ],
      "filter": [
        "removeEmptyAnchorsLinks",
        {
          "removeQueryParams": [
            "h",
            "locale2"
          ]
        }
      ],
      "remove": [
        {
          "startAfter": "div[role=\"main\"] h1",
          "endBefore": "[id$=\"_overview\"]"
        },
        "a:not([href])",
        "img"
      ],
      "executeClientScripts": true
    },
    "Developer Terms": {
      "fetch": "https://developers.facebook.com/policy",
      "filter": [
        "removeHelpButtons",
        "cleanUrls"
      ],
      "select": "._4bl9"
    },
    "Trackers Policy": {
      "fetch": "https://www.facebook.com/privacy/policies/cookies/printable/",
      "filter": [
        "cleanUrls",
        {
          "removeQueryParams": [
            "h"
          ]
        }
      ],
      "select": [
        "#root"
      ],
      "remove": [
        {
          "startAfter": "#root h1",
          "endBefore": "[id=\"0_intro\"]"
        },
        "a:not([href])",
        "img"
      ]
    },
    "Commercial Terms": {
      "fetch": "https://www.facebook.com/legal/commercial_terms",
      "select": [
        {
          "startBefore": "div[role=main]",
          "endBefore": "[role=\"separator\"]:first-child"
        }
      ],
      "filter": [
        "cleanUrls"
      ],
      "executeClientScripts": true
    },
    "Data Processor Agreement": {
      "fetch": "https://www.facebook.com/legal/EU_data_transfer_addendum",
      "select": [
        "div[role=main]"
      ],
      "remove": [
        {
          "startBefore": "[role=\"separator\"]",
          "endAfter": "body"
        }
      ],
      "executeClientScripts": true
    },
    "Live Policy": {
      "fetch": "https://en-gb.facebook.com/policies/live",
      "select": [
        "div[role=main]"
      ],
      "remove": [
        {
          "startBefore": "[role=\"separator\"]",
          "endAfter": "body"
        }
      ],
      "executeClientScripts": true
    },
    "Law Enforcement Guidelines": {
      "fetch": "https://www.meta.com/safety/communities/law/guidelines/",
      "filter": [
        "cleanUrls"
      ],
      "select": [
        "#safetyCenterContentContainer"
      ],
      "remove": [
        "a[href$=\"/safety/communities/law/\"]",
        "img"
      ]
    }
  }
}
