{
  "name": "Zoom",
  "terms": {
    "Terms of Service": {
      "fetch": "https://zoom.us/terms",
      "select": [
        "main"
      ],
      "remove": [
        ".fdn-breadcrumb__list"
      ],
      "filter": [
        "removeAmpDeviceId"
      ],
      "executeClientScripts": true
    },
    "Privacy Policy": {
      "fetch": "https://www.zoom.com/en/trust/privacy/privacy-statement/",
      "select": [
        "#main"
      ]
    }
  }
}
