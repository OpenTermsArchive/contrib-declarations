{
  "name": "Tagged",
  "terms": {
    "Terms of Service": {
      "fetch": "https://www.tagged.com/en/termsandconditions/",
      "select": [
        "article"
      ],
      "remove": [
        {
          "startBefore": "article > p:has(+ p > a[href^=\"#_Toc\"]:only-child)",
          "endBefore": "article > h1:has(a[id^=\"_Toc\"])"
        }
      ]
    },
    "Privacy Policy": {
      "fetch": "https://www.tagged.com/en/privacypolicy/",
      "select": [
        "article"
      ],
      "remove": [
        {
          "startBefore": "article > p:has(+ p > a[href^=\"#_Toc\"]:only-child)",
          "endBefore": "article > h1:has(a[id^=\"_Toc\"])"
        }
      ]
    }
  }
}
