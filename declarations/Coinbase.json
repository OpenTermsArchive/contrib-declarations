{
  "name": "Coinbase",
  "terms": {
    "Privacy Policy": {
      "fetch": "https://www.coinbase.com/legal/privacy",
      "select": [
        "main"
      ],
      "remove": [
        "[data-testid=\"icon-base-glyph\"]"
      ],
      "filter": [
        "removeReactTextSeparators"
      ],
      "executeClientScripts": true
    },
    "Trackers Policy": {
      "fetch": "https://www.coinbase.com/legal/cookie",
      "select": [
        "main"
      ],
      "filter": [
        "removeReactTextSeparators"
      ],
      "executeClientScripts": true
    },
    "Terms of Service": {
      "fetch": "https://www.coinbase.com/legal/user_agreement/ireland_europe",
      "select": [
        "main"
      ],
      "remove": [
        "aside"
      ],
      "filter": [
        "removeReactTextSeparators"
      ],
      "executeClientScripts": true
    }
  }
}
