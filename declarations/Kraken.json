{
  "name": "Kraken",
  "terms": {
    "Terms of Service": {
      "fetch": "https://www.kraken.com/en-us/legal/global-terms",
      "select": [
        "main"
      ],
      "executeClientScripts": true
    },
    "Privacy Policy": {
      "fetch": "https://www.kraken.com/en-us/legal/privacy/",
      "select": [
        "main"
      ],
      "remove": [
        "main nav",
        "[data-name^=Breadcrumb]",
        ".ds-container"
      ],
      "executeClientScripts": true
    },
    "Trackers Policy": {
      "fetch": "https://www.kraken.com/en-us/legal/cookies",
      "select": [
        "main"
      ],
      "remove": [
        ".wayfinder-header",
        ".wayfinder-wrapper"
      ],
      "executeClientScripts": true
    }
  }
}
