{
  "name": "Taboola",
  "terms": {
    "Terms of Service": {
      "fetch": "https://policies.taboola.com/terms-of-use/",
      "select": [
        ".main-content"
      ]
    },
    "Privacy Policy": {
      "fetch": "https://policies.taboola.com/privacy-policy/",
      "select": [
        ".main-content"
      ]
    },
    "Trackers Policy": {
      "fetch": "https://policies.taboola.com/cookie-policy/",
      "select": [
        ".main-content"
      ]
    },
    "Acceptable Use Policy": {
      "fetch": "https://help.taboola.com/hc/en-us/articles/115007068368-Prohibited-Content-Products-and-Services",
      "select": [
        ".article"
      ],
      "remove": [
        ".avatar,.article-meta,.article-subscribe,.article-votes,.article-relatives"
      ],
      "executeClientScripts": true
    }
  }
}
