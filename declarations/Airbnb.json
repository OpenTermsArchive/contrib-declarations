        {
          "startBefore": "h1",
          "endBefore": "#CEP_ARTICLES_SECTION_0"
        }
      ],
      "executeClientScripts": true
    },
    "Terms of Service": {
      "fetch": "https://www.airbnb.co.uk/help/article/2908/terms-of-service",
