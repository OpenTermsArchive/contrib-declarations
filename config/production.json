{
  "@opentermsarchive/engine": {
    "trackingSchedule": "0 6,18 * * *",
    "recorder": {
      "versions": {
        "storage": {
          "git": {
            "snapshotIdentiferTemplate": "https://github.com/OpenTermsArchive/contrib-snapshots/commit/%SNAPSHOT_ID",
            "repository": "git@github.com:OpenTermsArchive/contrib-versions.git",
            "path": "./data/versions"
          }
        }
      },
      "snapshots": {
        "storage": {
          "git": {
            "repository": "git@github.com:OpenTermsArchive/contrib-snapshots.git",
            "path": "./data/snapshots"
          }
        }
      }
    },
    "fetcher": {
      "language": "en-IE, en-GB, en"
    },
    "reporter": {
      "type": "github",
      "repositories": {
        "declarations": "OpenTermsArchive/contrib-declarations",
        "versions": "OpenTermsArchive/contrib-versions",
        "snapshots": "OpenTermsArchive/contrib-snapshots"
      }
    },
    "dataset": {
      "title": "contrib collection dataset",
      "versionsRepositoryURL": "https://github.com/OpenTermsArchive/contrib-versions",
      "datagouv": {
        "organizationIdOrSlug": "5ce284728b4c415a86c1fa31",
        "frequency": "weekly"
      }
    },
    "logger": {
      "timestampPrefix": false,
      "smtp": {
        "host": "smtp-relay.brevo.com",
        "port": 587,
        "username": "admin@opentermsarchive.org"
      }
    },
    "collection-api": {
      "port": 3000,
      "basePath": "/collection-api",
      "feed": {
        "versionUrlTemplate": "https://github.com/OpenTermsArchive/contrib-versions/commit/%VERSION_ID"
      }
    }
  }
}
